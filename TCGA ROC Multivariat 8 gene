# ========================================
# BAGIAN 11: TIME-DEPENDENT ROC TCGA-PRAD
# SIGNATURE 8 GEN: AKT1, MTOR, HDAC1, MMP9, HSP90AB1, CCNA2, RELA, CDK4
# ========================================

# ---------- Library ----------
if(!require(timeROC)) install.packages("timeROC")
if(!require(writexl)) install.packages("writexl")
library(timeROC)
library(writexl)

# ---------- KONFIGURASI ----------
downloads_path <- file.path(Sys.getenv("USERPROFILE"), "Downloads")
prad_dir       <- file.path(downloads_path, "TCGA-PRAD")

genes <- c("AKT1", "MTOR", "HDAC1", "MMP9", "HSP90AB1", "CCNA2", "RELA", "CDK4")

# Endpoint survival (dipakai hanya jika data punya kolom PFI): "OS" atau "PFI"
endpoint <- "OS"

# Ukuran teks legend (1 = normal; makin kecil makin mungil, coba 0.6 - 0.8)
legend_cex <- 0.7

# Waktu evaluasi: 1, 3, 5 tahun (dalam hari)
times_years <- c(1, 3, 5)
times <- 365 * times_years

# ---------- Fungsi bantu ----------
describe_obj <- function(o) {
  cl <- paste(class(o), collapse = "/")
  if(inherits(o, "SummarizedExperiment")) {
    return(paste0(cl, " | dim: ", paste(dim(o), collapse = " x "),
                  " | assay: ", paste(SummarizedExperiment::assayNames(o), collapse = ", ")))
  }
  if(is.matrix(o) || is.data.frame(o)) {
    return(paste0(cl, " | dim: ", paste(dim(o), collapse = " x "),
                  " | kolom: ", paste(head(colnames(o), 8), collapse = ", "),
                  if(ncol(o) > 8) " ..." else "",
                  " | rownames: ", paste(head(rownames(o), 3), collapse = ", ")))
  }
  paste0(cl, " | length: ", length(o))
}

# Ubah data frame klinis menjadi data.frame(patient, time, status); NULL jika tidak cocok
to_surv <- function(df, endpoint = "OS") {
  df <- as.data.frame(df, stringsAsFactors = FALSE)
  nm <- colnames(df)
  low <- tolower(nm)
  
  # ID pasien
  id_cands <- c("patient", "bcr_patient_barcode", "case_submitter_id", "submitter_id",
                "sample", "_patient", "barcode", "sampleid", "sample_id", "id")
  id_col <- nm[match(id_cands, low)]
  id_col <- id_col[!is.na(id_col)][1]
  if(!is.na(id_col)) {
    ids <- as.character(df[[id_col]])
  } else if(any(grepl("^TCGA-", rownames(df)))) {
    ids <- rownames(df)
  } else {
    return(NULL)
  }
  ids <- substr(ids, 1, 12)
  
  conv_status <- function(x) {
    if(is.character(x) || is.factor(x)) {
      x <- tolower(as.character(x))
      return(ifelse(x %in% c("dead", "deceased", "1", "event", "true"), 1,
                    ifelse(x %in% c("alive", "living", "0", "censored", "false"), 0, NA)))
    }
    x <- as.numeric(x)
    if(all(x[!is.na(x)] %in% c(1, 2))) x <- x - 1   # kode 1/2 -> 0/1
    x
  }
  
  time <- status <- NULL
  if(endpoint == "PFI" && all(c("PFI", "PFI.time") %in% nm)) {
    time <- as.numeric(df$PFI.time); status <- as.numeric(df$PFI)
  } else if(all(c("time", "status") %in% low)) {
    time   <- suppressWarnings(as.numeric(df[[nm[low == "time"][1]]]))
    status <- conv_status(df[[nm[low == "status"][1]]])
  } else if(all(c("OS", "OS.time") %in% nm)) {
    time <- as.numeric(df$OS.time); status <- as.numeric(df$OS)
  } else if(all(c("vital_status", "days_to_last_follow_up") %in% low)) {
    dtd <- if("days_to_death" %in% low) suppressWarnings(as.numeric(df[[nm[low == "days_to_death"][1]]])) else NA
    dfu <- suppressWarnings(as.numeric(df[[nm[low == "days_to_last_follow_up"][1]]]))
    status <- conv_status(df[[nm[low == "vital_status"][1]]])
    time <- ifelse(status == 1, dtd, dfu)
  } else {
    return(NULL)
  }
  
  out <- data.frame(patient = ids, time = time, status = status, stringsAsFactors = FALSE)
  out <- out[!is.na(out$time) & !is.na(out$status) & out$time > 0, ]
  out <- out[order(out$patient, -out$status, -out$time), ]   # prioritaskan event, lalu waktu terpanjang
  out[!duplicated(out$patient), ]
}

# Ambil matriks ekspresi (gen x sampel) dari objek; NULL jika tidak cocok
to_expr <- function(o) {
  m <- NULL
  if(inherits(o, "SummarizedExperiment")) {
    an <- SummarizedExperiment::assayNames(o)
    use_assay <- if("tpm_unstrand" %in% an) "tpm_unstrand" else
      if("fpkm_unstrand" %in% an) "fpkm_unstrand" else an[1]
    m  <- SummarizedExperiment::assay(o, use_assay)
    rd <- as.data.frame(SummarizedExperiment::rowData(o))
    if("gene_name" %in% colnames(rd)) rownames(m) <- rd$gene_name
    cat("   assay dipakai:", use_assay, "\n")
  } else if(is.matrix(o) || is.data.frame(o)) {
    if(is.data.frame(o) && ncol(o) > 50 && is.character(o[[1]])) {
      rn <- o[[1]]; o <- o[, -1, drop = FALSE]; rownames(o) <- make.unique(rn)
    }
    m <- as.matrix(o)
    # Orientasi: jika nama gen ada di kolom, transpose
    if(any(genes %in% colnames(m)) && !any(genes %in% rownames(m))) m <- t(m)
  }
  if(is.null(m) || !is.numeric(m)) return(NULL)
  
  # Jika ID berupa Ensembl, petakan ke simbol gen
  if(mean(grepl("^ENSG", rownames(m))) > 0.5) {
    if(!require("BiocManager")) install.packages("BiocManager")
    if(!require("org.Hs.eg.db")) BiocManager::install("org.Hs.eg.db", ask = FALSE)
    library(org.Hs.eg.db)
    ens <- sub("\\..*$", "", rownames(m))
    rownames(m) <- mapIds(org.Hs.eg.db, keys = ens, column = "SYMBOL",
                          keytype = "ENSEMBL", multiVals = "first")
  }
  m <- m[!is.na(rownames(m)), , drop = FALSE]
  if(!any(genes %in% rownames(m))) return(NULL)
  m
}

# ---------- Cek folder ----------
if(!dir.exists(prad_dir)) stop("Folder tidak ditemukan: ", prad_dir)
rds_files <- list.files(prad_dir, pattern = "\\.rds$", full.names = TRUE, ignore.case = TRUE)
if(length(rds_files) == 0) stop("Tidak ada file .rds di: ", prad_dir)

# Urutan baca: file kecil/matriks dulu, file mentah (terbesar) paling akhir
rds_files <- rds_files[order(file.size(rds_files))]

# ---------- Baca & periksa semua file (file mentah hanya dibaca jika perlu) ----------
if(!require("BiocManager")) install.packages("BiocManager")
if(!require("SummarizedExperiment")) BiocManager::install("SummarizedExperiment", ask = FALSE)
suppressMessages(library(SummarizedExperiment))

expr_mat <- NULL
clin     <- NULL
big_cut  <- 200 * 1024^2   # file > 200 MB dianggap mentah, dibaca terakhir

cat("=== ISI FILE DI", prad_dir, "===\n")
objs <- list()
for(f in rds_files[file.size(rds_files) <= big_cut]) {
  o <- readRDS(f)
  objs[[basename(f)]] <- o
  cat("\n", basename(f), "\n   ", describe_obj(o), "\n", sep = "")
}

# ---------- Cari klinis/survival ----------
for(nm in names(objs)) {
  o <- objs[[nm]]
  if(is.data.frame(o) && ncol(o) < 200) {
    cs <- to_surv(o, endpoint)
    if(!is.null(cs) && nrow(cs) > 50) {
      clin <- cs
      cat("\n>> Data survival diambil dari:", nm, "\n")
      break
    }
  }
}

# ---------- Cari ekspresi ----------
for(nm in names(objs)) {
  m <- tryCatch(to_expr(objs[[nm]]), error = function(e) NULL)
  if(!is.null(m)) {
    expr_mat <- m
    cat(">> Data ekspresi diambil dari:", nm, "\n")
    break
  }
}

# File mentah (SummarizedExperiment besar) sebagai cadangan
for(f in rds_files[file.size(rds_files) > big_cut]) {
  if(!is.null(expr_mat) && !is.null(clin)) break
  cat("\nMembaca file mentah (besar):", basename(f), "...\n")
  o <- readRDS(f)
  cat("   ", describe_obj(o), "\n")
  if(is.null(expr_mat)) {
    m <- tryCatch(to_expr(o), error = function(e) NULL)
    if(!is.null(m)) { expr_mat <- m; cat(">> Data ekspresi diambil dari:", basename(f), "\n") }
  }
  if(is.null(clin) && inherits(o, "SummarizedExperiment")) {
    cd <- as.data.frame(colData(o))
    cs <- to_surv(cd, endpoint)
    if(is.null(cs) && "patient" %in% colnames(cd)) {
      cd$bcr_patient_barcode <- cd$patient
      cs <- to_surv(cd, endpoint)
    }
    if(!is.null(cs) && nrow(cs) > 50) { clin <- cs; cat(">> Data survival diambil dari colData:", basename(f), "\n") }
  }
  rm(o); gc()
}

if(is.null(expr_mat)) stop("Data ekspresi gen tidak ditemukan. Kirim output 'ISI FILE' di atas ke saya.")
if(is.null(clin))     stop("Data survival tidak ditemukan. Kirim output 'ISI FILE' di atas ke saya.")

# ---------- Siapkan ekspresi 8 gen ----------
missing_genes <- setdiff(genes, rownames(expr_mat))
if(length(missing_genes) > 0) cat("\nPERINGATAN, gen tidak ditemukan:", missing_genes, "\n")
genes_use <- intersect(genes, rownames(expr_mat))

mode(expr_mat) <- "numeric"
expr_sub <- sapply(genes_use, function(g) {
  idx <- which(rownames(expr_mat) == g)
  if(length(idx) == 1) expr_mat[idx, ] else colMeans(expr_mat[idx, , drop = FALSE])
})
rownames(expr_sub) <- colnames(expr_mat)
expr_sub <- as.data.frame(expr_sub)

# Hanya sampel tumor primer (kode sampel 01), jika barcode cukup panjang
sample_ids <- rownames(expr_sub)
if(all(nchar(sample_ids) >= 15)) {
  expr_sub <- expr_sub[substr(sample_ids, 14, 15) == "01", , drop = FALSE]
}

# Log2 jika data terlihat belum di-log
if(max(expr_sub, na.rm = TRUE) > 100) expr_sub <- log2(expr_sub + 1)

# Level pasien (rata-rata jika ada duplikat)
expr_sub$patient <- substr(rownames(expr_sub), 1, 12)
expr_sub <- aggregate(. ~ patient, data = expr_sub, FUN = mean)

# ---------- Gabungkan & hitung skor 8 gen ----------
tcga_data <- merge(clin, expr_sub, by = "patient")
if(nrow(tcga_data) == 0) stop("Tidak ada pasien yang cocok antara ekspresi dan survival (cek format ID pasien).")

# Deteksi satuan waktu: jika maksimum < 200, kemungkinan bulan/tahun, bukan hari
if(max(tcga_data$time) < 200) {
  cat("PERINGATAN: waktu maksimum < 200, diasumsikan BULAN lalu dikonversi ke hari.\n")
  tcga_data$time <- tcga_data$time * 30.44
}

# Skor gabungan = rata-rata z-score tiap gen
z_mat <- scale(tcga_data[, genes_use, drop = FALSE])
tcga_data$Signature_score <- rowMeans(z_mat, na.rm = TRUE)

cat("\nJumlah pasien :", nrow(tcga_data), "\n")
cat("Jumlah event  :", sum(tcga_data$status == 1), "\n")
cat("Gen dipakai   :", paste(genes_use, collapse = ", "), "\n")
cat("Follow-up maks:", round(max(tcga_data$time) / 365, 1), "tahun\n\n")

# Hanya pakai waktu evaluasi yang masih dalam rentang follow-up
valid <- times < max(tcga_data$time)
times <- times[valid]
times_years <- times_years[valid]

# ---------- Time-dependent ROC ----------
roc_td <- timeROC(
  T = tcga_data$time,
  delta = tcga_data$status,
  marker = tcga_data$Signature_score,
  cause = 1,
  times = times,
  iid = TRUE
)

auc_df <- data.frame(
  Time_years = times_years,
  AUC = round(roc_td$AUC, 3)
)
print(auc_df)

# ---------- Fungsi plot ----------
colors <- c("green", "blue", "red")[seq_along(times)]
labels <- paste0(times_years, "-year")

plot_timeroc <- function() {
  plot(roc_td, time = times[1], col = colors[1], lwd = 2, title = FALSE)
  if(length(times) > 1) {
    for(i in 2:length(times)) {
      plot(roc_td, time = times[i], add = TRUE, col = colors[i], lwd = 2)
    }
  }
  abline(a = 0, b = 1, lty = 2, col = "gray50")
  title(main = paste0("TCGA-PRAD: 8-Gene Signature Time-dependent ROC (", endpoint, ")"),
        cex.main = 0.9)
  legend(
    "bottomright",
    legend = paste0(labels, ": AUC=", round(roc_td$AUC, 3)),
    col = colors,
    lwd = 2,
    cex = legend_cex,     # ukuran teks legend
    seg.len = 1.5,        # panjang garis warna di legend
    y.intersp = 0.9,      # jarak antar baris
    bty = "o"
  )
}

# Tampilkan di RStudio
plot_timeroc()

# ---------- Simpan plot ke Downloads ----------
out_file <- file.path(downloads_path, "9_TimeROC_TCGA_PRAD_8gene.png")
png(out_file, width = 800, height = 800, res = 150)
plot_timeroc()
dev.off()

cat("Time-dependent ROC curve disimpan di:", out_file, "\n")

# ========================================
# EKSPOR HASIL KE EXCEL
# ========================================

# ---------- Sheet 1: AUC + SE + 95% CI ----------
auc_full <- data.frame(
  Time_years = times_years,
  Time_days  = times,
  AUC        = round(as.numeric(roc_td$AUC), 4),
  stringsAsFactors = FALSE
)

# Standard error (tersedia karena iid = TRUE)
se_vec <- tryCatch(as.numeric(roc_td$inference$vect_sd_1), error = function(e) rep(NA_real_, length(times)))
if(length(se_vec) == length(times)) auc_full$SE <- round(se_vec, 4) else auc_full$SE <- NA_real_

# 95% CI (confint mengembalikan persen, jadi dibagi 100)
ci <- tryCatch(confint(roc_td, level = 0.95)$CI_AUC, error = function(e) NULL)
if(!is.null(ci) && nrow(ci) == length(times)) {
  auc_full$CI_lower_95 <- round(ci[, 1] / 100, 4)
  auc_full$CI_upper_95 <- round(ci[, 2] / 100, 4)
} else {
  auc_full$CI_lower_95 <- NA_real_
  auc_full$CI_upper_95 <- NA_real_
}

auc_full$N_patients <- nrow(tcga_data)
auc_full$N_events   <- sum(tcga_data$status == 1)
auc_full$Endpoint   <- endpoint

# ---------- Sheet 2: Koordinat kurva ROC ----------
roc_coords <- do.call(rbind, lapply(seq_along(times), function(i) {
  data.frame(
    Time_years        = times_years[i],
    One_minus_Specificity = as.numeric(roc_td$FP[, i]),
    Sensitivity       = as.numeric(roc_td$TP[, i]),
    stringsAsFactors = FALSE
  )
}))
roc_coords <- roc_coords[!is.na(roc_coords$One_minus_Specificity) & !is.na(roc_coords$Sensitivity), ]

# ---------- Sheet 3: Data per pasien ----------
patient_out <- tcga_data
patient_out$time_years <- round(patient_out$time / 365, 3)
patient_out <- patient_out[, c("patient", "time", "time_years", "status", genes_use, "Signature_score")]
patient_out[, c(genes_use, "Signature_score")] <- round(patient_out[, c(genes_use, "Signature_score")], 4)

# ---------- Tulis file Excel ----------
excel_file <- file.path(downloads_path, "9_TimeROC_TCGA_PRAD_8gene.xlsx")
write_xlsx(
  list(
    AUC             = auc_full,
    ROC_Coordinates = roc_coords,
    Patient_Data    = patient_out
  ),
  path = excel_file
)

cat("Hasil Excel disimpan di:", excel_file, "\n")
